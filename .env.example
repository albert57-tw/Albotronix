# Copy to .env and fill in. Leave an optional value blank to turn that feature off.

# --- Required ---
TOKEN=
GUILD_ID=

# --- THSR / TRA (https://tdx.transportdata.tw) ---
TDX_ID=
TDX_SECRET=
# THSR / TRA service-disruption alerts are posted here (blank = off); checked every N minutes
RAIL_ALERT_CHANNEL_ID=
RAIL_ALERT_MINUTES=5

# --- CTF & contests ---
CTF_CHANNEL_ID=
# Role to ping for CTF notifications (blank = no ping)
CTF_PING_ROLE_ID=
CTF_NOTIFY_TIME=00:00
# Only online CTFs with at least this CTFtime weight are listed, posted and reminded (0 = any weight)
CTF_MIN_WEIGHT=25
# Codeforces / AtCoder reminders and the LeetCode daily go here
CONTEST_CHANNEL_ID=
CONTEST_REFRESH_TIME=08:00
LEETCODE_TIME=08:05
# CSES daily problem with study hints (blank = the contest channel)
CSES_CHANNEL_ID=
CSES_TIME=08:10
EVENT_REMIND_MINUTES=60

# --- Fuel prices: weekly post on Sunday once CPC announces next week's prices ---
OIL_CHANNEL_ID=
OIL_TIME=13:00

# --- Security news (CISA KEV + critical CVEs) ---
SECURITY_CHANNEL_ID=
SECURITY_TIME=09:00
# Optional, raises the NVD rate limit: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Weather & earthquakes (https://opendata.cwa.gov.tw, free account) ---
CWA_KEY=
WEATHER_CHANNEL_ID=
WEATHER_CITY=臺南市
WEATHER_TIME=07:00
# Defaults to WEATHER_CHANNEL_ID
QUAKE_CHANNEL_ID=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_HISTORY_TURNS=10
AI_RATE_LIMIT=5
# Set to 1 only after enabling "Message Content Intent" in the Developer Portal (needed by /summarize)
MESSAGE_CONTENT_INTENT=0

# --- Fun ---
# Auto-react to this user's messages
REACT_USER_ID=
REACT_EMOJI=⚡

# --- Misc ---
DB_PATH=data/albotronix.db
